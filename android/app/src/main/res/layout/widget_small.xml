<?xml version="1.0" encoding="utf-8"?>
<!-- 下一堂, 待辦 (small) and 學期倒數 share this block (design/round-11/home-widgets.html). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="15dp" android:background="@drawable/widget_bg_card">
    <TextView android:id="@+id/header" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp" android:alpha="0.8" android:visibility="gone"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:baselineAligned="true">
        <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="36sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-black"/>
        <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="3dp" android:alpha="0.8"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:alpha="0.8"/>
    <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="1000" android:visibility="gone" />
    <TextView android:id="@+id/after" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:alpha="0.8" android:visibility="gone"/>
</LinearLayout>
