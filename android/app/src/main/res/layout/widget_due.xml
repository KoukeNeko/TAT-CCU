<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="15dp" android:background="@drawable/widget_bg_peach">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
        <TextView android:id="@+id/header" android:layout_width="0dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:textColor="#FFDBCB"/>
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#FFDBCB" android:alpha="0.8"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
