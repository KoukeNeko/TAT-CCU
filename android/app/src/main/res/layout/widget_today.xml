<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="14dp" android:background="@drawable/widget_bg_card">
    <LinearLayout android:layout_width="124dp" android:layout_height="match_parent" android:orientation="vertical"
        android:padding="12dp" android:background="@drawable/widget_bg_lilac">
        <TextView android:id="@+id/header" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#EADDFF"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:baselineAligned="true">
            <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-black" android:textColor="#EADDFF"/>
            <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="3dp" android:textColor="#EADDFF" android:alpha="0.8"/>
        </LinearLayout>
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#EADDFF" android:alpha="0.8"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/rows" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical" android:gravity="center_vertical" />
</LinearLayout>
